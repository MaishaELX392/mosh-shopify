{{ 'hero-cta.css' | asset_url | stylesheet_tag }}
<div class="hero-banner__cta-wrapper" {{ block.shopify_attributes }}>
  {% if block.settings.button_text != blank %}
    <a href="{{ block.settings.button_url }}" class="hero-banner__btn">
      <span>{{ block.settings.button_text }}</span>
      {% if block.settings.badge_text != blank %}
        <span class="hero-banner__btn-badge">{{ block.settings.badge_text }}</span>
      {% endif %}
    </a>
  {% endif %}
</div>

{% schema %}
{
  "name": "Hero CTA Button",
  "settings": [
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "GET THE VARIETY PACK"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button Link"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Save Badge Text",
      "default": "SAVE 20%"
    }
  ],
  "presets": [
    {
      "name": "Hero CTA Button"
    }
  ]
}
{% endschema %}