{{ 'feature-rows.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign desktop_image = block.settings.image_desktop
  assign mobile_image = block.settings.image_mobile | default: desktop_image
-%}

<div
  class="feature-row feature-row--left-image"
  style="background: {{ block.settings.row_bg }};"
  {{ block.shopify_attributes }}
>
  <div class="feature-row__wrapper">
    <div class="feature-row__media">
      {%- if desktop_image != blank -%}
        <picture class="feature-row__picture">
          {%- if block.settings.image_mobile != blank -%}
            <source
              media="(max-width: 991px)"
              srcset="{{ mobile_image | image_url: width: 800 }}"
            >
          {%- endif -%}
          {{
            desktop_image
            | image_url: width: 1400
            | image_tag:
              class: 'feature-row__image',
              loading: 'lazy',
              alt: desktop_image.alt
          }}
        </picture>
      {%- else -%}
        <div class="feature-row__placeholder">
          {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
        </div>
      {%- endif -%}

      {%- if block.settings.floating_icon != blank -%}
        <div class="feature-row__floating-icon">
          {{
            block.settings.floating_icon
            | image_url: width: 300
            | image_tag:
              loading: 'lazy',
              alt: 'Decoration'
          }}
        </div>
      {%- endif -%}
    </div>

    <div class="feature-row__content">
      {%- if block.settings.badge_text != blank -%}
        {%- liquid
          assign badge_style = 'color: ' | append: block.settings.badge_color | append: ';'

          if block.settings.badge_bg_image != blank
            assign badge_bg_url = block.settings.badge_bg_image | image_url: width: 300
            assign badge_style = badge_style | append: " background-image: url('" | append: badge_bg_url | append: "'); background-size: cover; background-position: center;"
          else
            assign badge_style = badge_style | append: ' background-color: #5b21b6;'
          endif
        -%}

        <div class="feature-row__badge" style="{{ badge_style }}">
          <span>{{ block.settings.badge_text }}</span>
        </div>
      {%- endif -%}

      {%- if block.settings.heading != blank -%}
        <h2
          class="feature-row__heading"
          style="color: {{ block.settings.heading_color }};"
        >
          {{ block.settings.heading }}
        </h2>
      {%- endif -%}

      {%- if block.settings.description != blank -%}
        <div
          class="feature-row__description"
          style="--description-color: {{ block.settings.text_color | default: '#5b21b6' }};"
        >
          {{ block.settings.description }}
        </div>
      {%- endif -%}

      {%- if block.settings.quote_text != blank -%}
        <div
          class="feature-row__quote"
          style="background: {{ block.settings.quote_bg }}; color: {{ block.settings.quote_color }};"
        >
          <p>“{{ block.settings.quote_text }}”</p>
        </div>
      {%- endif -%}
    </div>
  </div>

  {%- if block.settings.middle_icon != blank -%}
    <div class="feature-row__middle-icon">
      {{
        block.settings.middle_icon
        | image_url: width: 300
        | image_tag:
          loading: 'lazy',
          alt: 'Middle decoration'
      }}
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Left Image Block",
  "settings": [
    {
      "type": "header",
      "content": "Image Settings"
    },
    {
      "type": "image_picker",
      "id": "image_desktop",
      "label": "Desktop Feature Image"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile Feature Image"
    },
    {
      "type": "image_picker",
      "id": "floating_icon",
      "label": "Floating Icon"
    },
    {
      "type": "image_picker",
      "id": "middle_icon",
      "label": "Middle Icon"
    },
    {
      "type": "header",
      "content": "Content Settings"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Number Text",
      "default": "00"
    },
    {
      "type": "image_picker",
      "id": "badge_bg_image",
      "label": "Badge Background Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Made for Your Brain, by People With a Mission"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Maria Shriver and her son Patrick started MOSH after Alzheimer's hit their family. Six brain nutrients you won't find in most bars.</p>"
    },
    {
      "type": "textarea",
      "id": "quote_text",
      "label": "Quote Text",
      "default": "Good tasting healthy protein bars with a boost for your brain!"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color_background",
      "id": "row_bg",
      "label": "Row Background",
      "default": "linear-gradient(0deg, #FDF7FF, #FDF7FF)"
    },
    {
      "type": "color",
      "id": "badge_color",
      "label": "Badge Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#5b21b6"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Description Text Color",
      "default": "#5b21b6"
    },
    {
      "type": "color",
      "id": "quote_bg",
      "label": "Quote Box Background",
      "default": "#F3E8FF"
    },
    {
      "type": "color",
      "id": "quote_color",
      "label": "Quote Text Color",
      "default": "#5b21b6"
    }
  ],
  "presets": [
    {
      "name": "Left Image Block"
    }
  ]
}
{% endschema %}