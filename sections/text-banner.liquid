{{ 'text-banner.css' | asset_url | stylesheet_tag }}

<section
  id="TextBanner-{{ section.id }}"
  class="text-banner"
  style="--tb-bg: {{ section.settings.bg_color }};"
>
  <div class="text-banner__wrapper">
    {% if section.settings.heading != blank %}
      <h2 class="text-banner__heading">
        {{ section.settings.heading }}
      </h2>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Text Banner",
  "tag": "section",
  "class": "section-text-banner",
  "settings": [
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading / Text",
      "default": "<p>Here's why so many people say MOSH is the first bar they've stuck with:</p>"
    },
    {
      "type": "color_background",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FAF5FF"
    }
  ],
  "presets": [
    {
      "name": "Text Banner"
    }
  ]
}
{% endschema %}