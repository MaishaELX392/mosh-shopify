{{ 'promo.css' | asset_url | stylesheet_tag }}
{{ 'hero-cta.css' | asset_url | stylesheet_tag }}


{%- liquid
  assign desktop_image = section.settings.image_desktop
  assign mobile_image = section.settings.image_mobile | default: desktop_image
-%}

<section
  id="Promo-{{ section.id }}"
  class="promo"
  style="
    {% if desktop_image != blank %}
      --desktop-aspect: {{ desktop_image.aspect_ratio }};
    {% endif %}
    {% if mobile_image != blank %}
      --mobile-aspect: {{ mobile_image.aspect_ratio }};
    {% endif %}
  "
>
  <!-- Background Image Container -->
  <div class="promo__media-background">
    {%- if desktop_image != blank -%}
      <picture class="promo__picture">
        {%- if section.settings.image_mobile != blank -%}
          <source
            media="(max-width: 991px)"
            srcset="{{ mobile_image | image_url: width: 1000 }}"
          >
        {%- endif -%}
        {{
          desktop_image
          | image_url: width: 2000
          | image_tag:
            class: 'promo__image',
            loading: 'lazy',
            alt: desktop_image.alt
        }}
      </picture>
    {%- else -%}
      <div class="promo__placeholder">
        {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
      </div>
    {%- endif -%}
  </div>

  <!-- Content Container Over Background -->
  <div class="promo__container">
    <div class="promo__content">
      {%- if section.settings.heading != blank -%}
        <h2 class="promo__heading">
          {{ section.settings.heading }}
        </h2>
      {%- endif -%}

      {%- if section.settings.description != blank -%}
        <div class="promo__description">
          {{ section.settings.description }}
        </div>
      {%- endif -%}

      <div class="promo__cta-wrapper">
        {% content_for 'blocks' %}
      </div>

      <!-- Footer (Stars & Support) -->
      <div class="promo__footer">
        <div class="promo__reviews">
          <div class="promo__stars">
            {% for i in (1..5) %}
              <svg class="promo__star-icon" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
                <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/>
              </svg>
            {% endfor %}
          </div>
          <span class="promo__reviews-text">
            <strong>4.9 stars,</strong> 11,000+ reviews
          </span>
        </div>

        <div class="promo__divider"></div>

        <div class="promo__support">
          <p class="promo__support-text">
            A portion of every purchase supports women's Alzheimer's research
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Promo Banner",
  "tag": "section",
  "class": "section-promo",
  "settings": [
    {
      "type": "header",
      "content": "Image Settings"
    },
    {
      "type": "image_picker",
      "id": "image_desktop",
      "label": "Desktop Background Image"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile Background Image"
    },
    {
      "type": "header",
      "content": "Content Settings"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Swap One Snack. See What Changes"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>15 bars. 6 flavors. 4g of sugar or less. Free 6-pack with your first order, and a 30-day guarantee if you don't love them.</p>"
    }
  ],
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "Promo Banner"
    }
  ]
}
{% endschema %}