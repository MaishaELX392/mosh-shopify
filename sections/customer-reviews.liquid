{{ 'customer-reviews.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign section_bg_style = ''
  if section.settings.section_bg != blank
    assign section_bg_style = "background: " | append: section.settings.section_bg | append: ";"
  endif
-%}

<section class="customer-reviews full-width" style="{{ section_bg_style }}">
  <div class="customer-reviews__container">
    
    {% if section.settings.heading != blank %}
      <h2 class="customer-reviews__heading">{{ section.settings.heading }}</h2>
    {% endif %}

    <div class="customer-reviews__grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign card_bg_style = ''
          if block.settings.card_bg_image != blank
            assign bg_url = block.settings.card_bg_image | image_url: width: 1000
            assign card_bg_style = "background-image: url('" | append: bg_url | append: "'); background-size: 100% 100%; background-repeat: no-repeat; background-position: center;"
          elsif block.settings.card_bg != blank
            assign card_bg_style = "background: " | append: block.settings.card_bg | append: ";"
          endif
        -%}
        <div class="customer-reviews__card" style="{{ card_bg_style }}" {{ block.shopify_attributes }}>
          <div class="customer-reviews__stars">
            <img
              src="{{ 'Testimonial_rating_star.svg' | asset_url }}"
              alt="Star Rating"
              class="customer-reviews__star-icon"
              width="16"
              height="16"
              loading="lazy"
            >
            <img
              src="{{ 'Testimonial_rating_star.svg' | asset_url }}"
              alt="Star Rating"
              class="customer-reviews__star-icon"
              width="16"
              height="16"
              loading="lazy"
            >
            <img
              src="{{ 'Testimonial_rating_star.svg' | asset_url }}"
              alt="Star Rating"
              class="customer-reviews__star-icon"
              width="16"
              height="16"
              loading="lazy"
            >
            <img
              src="{{ 'Testimonial_rating_star.svg' | asset_url }}"
              alt="Star Rating"
              class="customer-reviews__star-icon"
              width="16"
              height="16"
              loading="lazy"
            >
            <img
              src="{{ 'Testimonial_rating_star.svg' | asset_url }}"
              alt="Star Rating"
              class="customer-reviews__star-icon"
              width="16"
              height="16"
              loading="lazy"
            >
          </div>

          {% if block.settings.review_text != blank %}
            <p class="customer-reviews__text">“{{ block.settings.review_text }}”</p>
          {% endif %}

          {% if block.settings.author_name != blank %}
            <span class="customer-reviews__author">— {{ block.settings.author_name }}</span>
          {% endif %}
        </div>
      {%- endfor -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Customer Reviews Grid",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "What Customers Say After The First Box"
    },
    {
      "type": "color_background",
      "id": "section_bg",
      "label": "Section Background",
      "default": "linear-gradient(0deg, #FDF7FF, #FDF7FF)"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review Card",
      "settings": [
        {
          "type": "color_background",
          "id": "card_bg",
          "label": "Card Background Color/Gradient",
          "default": "linear-gradient(0deg, #FDF7FF, #FDF7FF)"
        },
        {
          "type": "image_picker",
          "id": "card_bg_image",
          "label": "Card Background Image (Optional)"
        },
        {
          "type": "textarea",
          "id": "review_text",
          "label": "Review Quote",
          "default": "Great nutrition bar, tasty and reasonable calorie count. Half a bar is enough for a snack!"
        },
        {
          "type": "text",
          "id": "author_name",
          "label": "Author Name",
          "default": "Gloria"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Customer Reviews Grid",
      "blocks": [
        {
          "type": "review",
          "settings": {
            "review_text": "Great nutrition bar, tasty and reasonable calorie count. Half a bar is enough for a snack!",
            "author_name": "Gloria"
          }
        },
        {
          "type": "review",
          "settings": {
            "review_text": "I wasn't sure if I'd like the texture or if I'd like the taste but all the ingredients seemed good so I decided to take a chance.",
            "author_name": "Name"
          }
        },
        {
          "type": "review",
          "settings": {
            "review_text": "Every type of protein or energy bar that is \"health food\" oriented you can find. Nothing has been as satisfying, beneficial or tasty as Mosh.",
            "author_name": "Name"
          }
        },
        {
          "type": "review",
          "settings": {
            "review_text": "Great bar. It is more expensive than other bars but if it a meal substitute I think it is a good choice. Low sugar.",
            "author_name": "Name"
          }
        },
        {
          "type": "review",
          "settings": {
            "review_text": "Viewed your ad on Facebook. I've always admired Maria and wanted to contribute to the cause. I love the product. It is now my go-to bar every day.",
            "author_name": "Name"
          }
        },
        {
          "type": "review",
          "settings": {
            "review_text": "I'm a 72 year old who doesn't feel 72 and wants to stay as healthy as I can!",
            "author_name": "Name"
          }
        }
      ]
    }
  ]
}
{% endschema %}