{{ 'hero-banner.css' | asset_url | stylesheet_tag }}

<section class="hero-banner full-width">
  <div class="hero-banner__container">
    <div class="hero-banner__content">
      
      {% if section.settings.title != blank %}
        <h1 class="hero-banner__title">
          <span>5 Reasons Why Thousands</span>
          <span>Are Swapping Their</span>
          <span>Afternoon Snack for a</span>
          <span class="hero-banner__title-highlight">Bar Made for the Brain</span>
        </h1>
      {% endif %}

      {% if section.settings.subtitle != blank %}
        <p class="hero-banner__subtitle">{{ section.settings.subtitle }}</p>
      {% endif %}

      <div class="hero-banner__blocks">
        {% content_for 'blocks' %}
      </div>

    </div>
  </div>
</section>

{% style %}
  /* Desktop Background Image */
  {% if section.settings.background_image != blank %}
    .hero-banner {
      background-image: url('{{ section.settings.background_image | image_url: width: 2000 }}');
    }
  {% endif %}

  /* Mobile Background Image & Aspect Ratio Sizing */
  @media (max-width: 768px) {
    .hero-banner {
      {% assign mobile_img = section.settings.mobile_background_image | default: section.settings.background_image %}
      
      {% if mobile_img != blank %}
        background-image: url('{{ mobile_img | image_url: width: 1000 }}');
        /* Sets the aspect ratio dynamically based on the uploaded mobile image */
        aspect-ratio: {{ mobile_img.aspect_ratio }};
      {% endif %}
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Hero Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Desktop Background Image"
    },
    {
      "type": "image_picker",
      "id": "mobile_background_image",
      "label": "Mobile Background Image"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "5 Reasons Why Thousands Are Swapping Their Afternoon Snack for a Bar Made for the Brain"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "You want something sweet with your coffee. You don't want the sugar or the crash. What if your snack was the smartest thing you ate all day?"
    }
  ],
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "Hero Banner"
    }
  ]
}
{% endschema %}