{{ 'hero-banner.css' | asset_url | stylesheet_tag }}

<section class="hero-banner full-width" style="background-image: url('{{ section.settings.background_image | image_url: width: 2000 }}');">
  <div class="hero-banner__container">
    <div class="hero-banner__content">
      
      {% if section.settings.title != blank %}
        <h1 class="hero-banner__title">{{ section.settings.title }}</h1>
      {% endif %}

      {% if section.settings.subtitle != blank %}
        <p class="hero-banner__subtitle">{{ section.settings.subtitle }}</p>
      {% endif %}

      <div class="hero-banner__blocks">
        {% content_for 'blocks' %}
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background Image"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "5 Reasons Why Thousands Are Swapping Their Afternoon Snack for a Bar Made for the Brain"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "You want something sweet with your coffee. You don't want the sugar or the crash. What if your snack was the smartest thing you ate all day?"
    }
  ],
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "Hero Banner"
    }
  ]
}
{% endschema %}